{
  "permissions": {
    "allow": [
      "Bash(python -m clipkit --json doctor)",
      "Bash(python -m clipkit *)",
      "Bash(python -m pytest *)",
      "Bash(ffmpeg -version)",
      "Bash(ffprobe -version)",
      "Bash(yt-dlp --version)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(gh repo create *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/validate_output_root.py --hook-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
