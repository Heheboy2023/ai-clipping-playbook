{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single candidate record reference",
  "description": "Human-readable copy of the candidate item contract. The canonical machine contract is schemas/candidate.schema.json.",
  "type": "object",
  "required": ["candidate_id", "start", "end", "summary"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "start": {"type": "number", "minimum": 0},
    "end": {"type": "number", "exclusiveMinimum": 0},
    "summary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
