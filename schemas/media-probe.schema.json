{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/clipkit/media-probe.schema.json",
  "title": "Clipkit media probe",
  "type": "object",
  "required": ["input", "streams", "format"],
  "properties": {
    "input": {"type": "string"},
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["codec_type"],
        "properties": {
          "codec_type": {"enum": ["video", "audio", "subtitle", "data", "attachment"]},
          "codec_name": {"type": ["string", "null"]},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    },
    "format": {"type": "object"}
  },
  "additionalProperties": true
}
