{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clipkit normalized transcript",
  "type": "object",
  "required": ["schema_version", "segments", "human_playback_review_required"],
  "properties": {
    "schema_version": {"const": 1},
    "human_playback_review_required": {"const": true},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end", "text"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "text": {"type": "string", "minLength": 1},
          "speaker": {"type": ["string", "null"]}
        }
      }
    }
  }
}

